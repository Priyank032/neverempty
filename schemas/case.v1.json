{
  "$defs": {
    "ArgExpectation": {
      "additionalProperties": false,
      "description": "One expected argument, under one match mode.",
      "properties": {
        "match": {
          "default": "exact",
          "enum": [
            "exact",
            "normalized",
            "set",
            "numeric",
            "regex",
            "present",
            "date"
          ],
          "title": "Match",
          "type": "string"
        },
        "tol": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tol"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "title": "ArgExpectation",
      "type": "object"
    },
    "CaseInput": {
      "additionalProperties": false,
      "description": "Exactly one of ``messages`` (chat agents) or ``payload`` (everything else).",
      "properties": {
        "messages": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Message"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Messages"
        },
        "payload": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload"
        }
      },
      "title": "CaseInput",
      "type": "object"
    },
    "Expect": {
      "additionalProperties": false,
      "description": "What the case asserts. Every key optional, at least one present.\n\n``None`` means \"not asked\" and an empty list means \"asked for none\". A\nscorer keys on that difference to report not-applicable rather than pass.",
      "properties": {
        "facts": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Fact"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Facts"
        },
        "forbidden_claims": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Fact"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forbidden Claims"
        },
        "forbidden_tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forbidden Tools"
        },
        "items": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ItemExpectation"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Items"
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteExpectation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tool_calls": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCallExpectation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Expect",
      "type": "object"
    },
    "ExpectedCall": {
      "additionalProperties": false,
      "description": "One expected tool call.",
      "properties": {
        "args": {
          "additionalProperties": {
            "$ref": "#/$defs/ArgExpectation"
          },
          "title": "Args",
          "type": "object"
        },
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool"
      ],
      "title": "ExpectedCall",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "description": "A claim the answer should (or must not) contain.",
      "properties": {
        "evidence_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Key"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "match": {
          "enum": [
            "contains",
            "regex",
            "judge"
          ],
          "title": "Match",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement",
        "match"
      ],
      "title": "Fact",
      "type": "object"
    },
    "FaultDecl": {
      "additionalProperties": false,
      "description": "A fault to inject for this case.",
      "properties": {
        "after_calls": {
          "default": 0,
          "minimum": 0,
          "title": "After Calls",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "timeout",
            "upstream",
            "rate_limit",
            "empty",
            "truncated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "kind"
      ],
      "title": "FaultDecl",
      "type": "object"
    },
    "ItemExpectation": {
      "additionalProperties": false,
      "description": "Per-item ground truth for generated suites.\n\n``rule_result`` is a true three-way value: ``None`` means the rule could\nnot evaluate, which is a different claim from \"ineligible\" and is the case\nmost likely to catch an agent overclaiming.",
      "properties": {
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "rule_result": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Result"
        },
        "rule_trace": {
          "items": {
            "$ref": "#/$defs/RuleStep"
          },
          "title": "Rule Trace",
          "type": "array"
        }
      },
      "required": [
        "item_id"
      ],
      "title": "ItemExpectation",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "description": "One chat turn.",
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "Message",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where this case's ground truth came from.\n\nRequired on the test split: a published number has to be able to say who\ndecided the right answer, and when.",
      "properties": {
        "labelled_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Labelled At"
        },
        "labeller": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Labeller"
        },
        "method": {
          "enum": [
            "human",
            "llm_drafted_human_verified",
            "generated_from_rules"
          ],
          "title": "Method",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "scheme_file_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheme File Sha256"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        }
      },
      "required": [
        "method"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RouteExpectation": {
      "additionalProperties": false,
      "description": "The branch the agent should take.\n\nLabels are free strings. The library never knows a target's branch names,\nso adding one later is a dataset edit; the target adapter asserts at import\ntime that every branch exists in the compiled graph, which is where a typo\ncan actually be caught.",
      "properties": {
        "acceptable": {
          "items": {
            "type": "string"
          },
          "title": "Acceptable",
          "type": "array"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "RouteExpectation",
      "type": "object"
    },
    "RuleStep": {
      "additionalProperties": false,
      "description": "One criterion from a rule engine's trace.",
      "properties": {
        "criterion": {
          "minLength": 1,
          "title": "Criterion",
          "type": "string"
        },
        "missing_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Field"
        },
        "result": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        }
      },
      "required": [
        "criterion"
      ],
      "title": "RuleStep",
      "type": "object"
    },
    "ToolCallExpectation": {
      "additionalProperties": false,
      "description": "Which tools should be called, and how strictly the order matters.",
      "properties": {
        "calls": {
          "items": {
            "$ref": "#/$defs/ExpectedCall"
          },
          "minItems": 1,
          "title": "Calls",
          "type": "array"
        },
        "mode": {
          "enum": [
            "first",
            "set",
            "sequence"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "calls"
      ],
      "title": "ToolCallExpectation",
      "type": "object"
    }
  },
  "$id": "https://github.com/priyank-agrawal/neverempty/blob/main/schemas/case.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One dataset line. Unknown keys are rejected: a typo in eval data is a silent killer, because a misspelled expectation is an absent one, and an absent expectation reports not-applicable rather than failing.",
  "properties": {
    "expect": {
      "$ref": "#/$defs/Expect"
    },
    "faults": {
      "items": {
        "$ref": "#/$defs/FaultDecl"
      },
      "title": "Faults",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "input": {
      "$ref": "#/$defs/CaseInput"
    },
    "must_pass": {
      "default": false,
      "title": "Must Pass",
      "type": "boolean"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "split": {
      "enum": [
        "dev",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "suite": {
      "title": "Suite",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "id",
    "suite",
    "split",
    "input",
    "expect"
  ],
  "title": "neverempty Case v1",
  "type": "object"
}
